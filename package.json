{
  "name": "@componentor/fs",
  "version": "4.2.2",
  "description": "Node's fs in the browser, including a real synchronous readFileSync/writeFileSync, stored in OPFS. Handles the workers, cross-tab locking and encodings for you.",
  "license": "MIT",
  "author": "Componentor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/componentor/fs.git"
  },
  "bugs": {
    "url": "https://github.com/componentor/fs/issues"
  },
  "homepage": "https://github.com/componentor/fs#readme",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.mts",
  "//sideEffects": "All modules are side-effect-free so bundlers can tree-shake (e.g. importing only the drive classes drops the VFS engine). The worker entry files DO have side effects (self.onmessage) — they're loaded as separate worker bundles, never imported for their side effects, but listed here defensively.",
  "sideEffects": [
    "**/*.worker.js",
    "**/workers/*.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.js"
    },
    "./drives": {
      "types": "./dist/drives-entry.d.mts",
      "import": "./dist/drives-entry.js"
    },
    "./sw": "./dist/workers/service.worker.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node src/scripts/build.mjs",
    "dev": "node src/scripts/build.mjs && cd src && npx tsup --watch",
    "test": "cd src && npx vitest run",
    "example": "node examples/serve.js",
    "benchmark": "npm run build && playwright test",
    "benchmark:server": "node tests/benchmark/server.js",
    "benchmark:open": "npm run build && PORT=3030 node tests/benchmark/server.js",
    "benchmark:open:no-coep": "npm run build && PORT=3030 node tests/benchmark/server.js --no-coep",
    "typecheck": "tsc -p src/tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm test && npm run build",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@isomorphic-git/lightning-fs": "^4.6.0",
    "@playwright/test": "^1.40.0",
    "@types/node": "^25.0.3",
    "@vitest/browser": "^4.0.16",
    "@vitest/browser-playwright": "^4.0.16",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "isomorphic-git": "^1.41.3",
    "playwright": "^1.40.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.16"
  },
  "keywords": [
    "opfs",
    "origin-private-file-system",
    "web-worker",
    "filesystem",
    "fs",
    "polyfill",
    "browser-storage",
    "file-api",
    "shim",
    "sync",
    "async",
    "typescript",
    "shared-array-buffer",
    "vfs",
    "readfilesync",
    "writefilesync",
    "browser-filesystem",
    "node-fs",
    "virtual-filesystem",
    "isomorphic-git",
    "sync-fs",
    "in-browser",
    "web-ide",
    "storage"
  ]
}
